<?xml version="1.0" encoding="UTF-8"?>
<!--
  크롬 방문 기록을 한 시간마다 보낸다.
  직접 복사하지 않는다 — collectors/install.sh 가 __REPO__ 같은 자리를 채워 올린다.
  토큰은 여기 적지 않는다. ~/Library/Application Support/jarvis/token 에서 읽는다.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.jarvis.chrome</string>

    <!-- 맥 시스템 파이썬. launchd 는 로그인 셸을 안 거쳐 anaconda 가 안 보인다. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>collectors.chrome_history</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>JARVIS_SERVER</key>
        <string>__SERVER__</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- 한 시간마다. 맥이 잠들어 건너뛰어도 커서가 있어 구멍이 안 난다. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__LOGS__/chrome.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS__/chrome.log</string>
</dict>
</plist>
