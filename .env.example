# 관측치 저장소
JARVIS_DB_PATH=data/jarvis.db

# 아이폰 단축어가 보낼 인증 토큰 (아무 긴 랜덤 문자열)
# 만들기: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_INGEST_TOKEN=
