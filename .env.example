# 텔레그램 봇 (@BotFather에서 발급)
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_CHAT_ID=

# vLLM OpenAI 호환 API (데스크탑 서버 Tailscale 주소)
JARVIS_BRAIN_URL=http://100.98.90.38:8000
# 비워두면 서버에 떠 있는 모델을 자동으로 찾는다
JARVIS_BRAIN_MODEL=

# 웹 검색(SearXNG). 비우면 자비스는 검색하지 않는다. 기본은 데스크탑의 :8888
JARVIS_SEARCH_URL=http://100.98.90.38:8888

# 대화가 브라우저(헤드리스 크롬)를 직접 다루나. 기본 켬. 끄려면 0 (SETUP 의 브라우저)
JARVIS_BROWSER=1
# 크롬이 있는 폴더. 리눅스 기본은 root 가 가진 /opt/jarvis/ms-playwright (SETUP 의 브라우저). 맥은 비움
# JARVIS_BROWSERS_PATH=/opt/jarvis/ms-playwright

# 자비스 루프 주기 (초). 기본 30분
JARVIS_LOOP_INTERVAL_SEC=1800

# 관측치 저장소
JARVIS_DB_PATH=data/jarvis.db

# 아이폰 단축어가 보낼 인증 토큰 (아무 긴 랜덤 문자열)
# 만들기: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_INGEST_TOKEN=
